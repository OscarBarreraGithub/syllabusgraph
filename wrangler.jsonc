{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syllabusgraph",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./.syllabusgraph/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "env": {
    "production": {
      "name": "syllabusgraph",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "sciencewithagents.com", "custom_domain": true },
        { "pattern": "www.sciencewithagents.com", "custom_domain": true }
      ]
    }
  }
}
